# Modèle à copier sur le Pi vers /home/pi/infra/nginx/conf.d/docstools.conf
# (hors de ce dépôt — infra/ est partagé entre tous les sites, voir
# docs/deploiement.md). Adapter le sous-domaine si besoin.

server {
    listen 80;
    server_name docstools.dorianvidal.com;
    location / {
        proxy_pass http://docstools_web:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
